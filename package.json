{
  "name": "arc-mcp-hub",
  "version": "0.1.0",
  "description": "Deterministic multi-system MCP hub for SAP BTP — one login, per-environment routing to ARC-1 backends.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "arc-mcp-hub": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "xs-security.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@arc-mcp/xsuaa-auth": "^0.1.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.1.0",
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
